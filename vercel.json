{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.dollpictures.in" }],
      "destination": "https://dollpictures.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/employee",
      "destination": "/"
    },
    {
      "source": "/employee/:path*",
      "destination": "/"
    },
    {
      "source": "/kiosk",
      "destination": "/"
    },
    {
      "source": "/kiosk/:path*",
      "destination": "/"
    },
    {
      "source": "/quotation/:path*",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/employee/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/kiosk/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/quotation/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
