# Backend API base URL (includes /api prefix).
# Used at runtime by the app and by prerendering to load CMS SEO overlays.
# Set this in Netlify/Vercel production env as well.
VITE_API_URL=http://localhost:3001/api

# Fail production prerendering instead of silently omitting CMS SEO routes.
# Set this to true in Vercel/Netlify production environments.
SEO_REQUIRE_CMS=false

# Admin direct-upload limit enforced before requesting an R2 signed URL.
VITE_MAX_UPLOAD_SIZE_MB=25

# Optional: force the admin dashboard to use its bundled sample records.
# In local development, sample records are already used when both APIs are empty.
VITE_ADMIN_DASHBOARD_MOCK_DATA=false

# Public site origin (no trailing slash). Used at build time for robots.txt,
# prerender canonicals/OG URLs, and runtime SEO absolute URLs.
# Set this in Netlify/Vercel production env as well.
VITE_SITE_URL=https://dollpictures.in

# Google Analytics 4 measurement ID (production only)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID (production only; leave blank to disable)
VITE_META_PIXEL_ID=
